# Copie este arquivo para ".env" e ajuste os valores locais.

# PostgreSQL (container Docker com a porta do host mapeada para 5435)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=nome_do_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Arquivos JSON usados na carga inicial (só se a tabela estiver vazia), relativos à raiz do projeto
CAMINHO_JSON_INSTITUICOES=datasets/escolas_pb_matriculas_2025.json
CAMINHO_JSON_USUARIOS=datasets/usuarios.json

# Servidor Flask
FLASK_DEBUG=false
FLASK_PORT=5000

# Maior valor aceito no parâmetro "limit" da paginação
LIMIT_MAXIMO_PAGINA=1000
